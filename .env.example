# Gemini API key from https://aistudio.google.com/api-keys
# Keep this server-only; never prefix it with VITE_ or commit the real key.
GEMINI_API_KEY=add_your_gemini_api_key_here

# Optional Gemini model setting
GEMINI_MODEL=gemini-3-flash-preview
# Automatically tried if the primary model returns a temporary 503.
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest

# Server configuration
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_BYTES=8388608
